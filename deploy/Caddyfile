{
	admin off
	default_sni {$PUBLIC_HOST}
}

{$PUBLIC_HOST} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	reverse_proxy app:8765 {
		# FastAPI trusts the internal host; browser Origin is checked separately.
		header_up Host localhost
		flush_interval -1
	}
}
