# No secrets: subscription credentials are created in the persistent volume.
APP_PORT=8765
# Leave empty to select a model from the connected subscription catalog.
AI_MODEL=
AI_CALLBACK_PORT=1456
# Add the exact chrome-extension://<installed-extension-id> origin when installing.
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
# Optional compose.network.yaml only; leave unset for the default direct connection.
# OPENAI_HTTPS_PROXY=http://host.docker.internal:8766
# HOST_CA_BUNDLE=/absolute/path/to/your/existing-public-ca-bundle.pem
